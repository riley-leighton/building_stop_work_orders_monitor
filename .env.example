# If your Postgres needs a login: postgresql://user:password@localhost:5432/stop_work_orders
DATABASE_URL=postgresql://localhost:5432/stop_work_orders

# Any SMTP server works. For Gmail, use an app password (see README).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Usually the same as SMTP_USER
MAIL_FROM=
# Who gets the alerts, comma separated
NOTIFY_TO=
